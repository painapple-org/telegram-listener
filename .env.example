# Telegram bot token (from @BotFather).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user ids allowed to talk to this bot.
# Everyone else is dropped and logged. Required: the listener refuses to
# start on an empty allowlist rather than run allowlisting nobody.
TELEGRAM_ALLOWED_USER_IDS=

# Optional second gate: comma-separated numeric chat ids an allowlisted
# user may talk to this bot from. Empty means any chat, including a group a
# stranger added the bot to. Set it to pin the bot to known chats.
# TELEGRAM_ALLOWED_CHAT_IDS=

# module.path:factory for the dispatch plugin to load - see
# telegram_listener/plugin.py. The example plugin shipped in this repo:
DISPATCH_PLUGIN=plugins.claude_agent:build_plugin

# Only needed by the claude_agent example plugin.
# CLAUDE_AGENT_MODEL=

# telegram-bot-api (installer/docker-compose.yml) - obtain from
# https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Where the listener stores its state (offset, transcripts, sessions,
# downloaded files). When unset, /data if it exists, else ./data.
# TELEGRAM_LISTENER_DATA_DIR=

# Where the listener reaches the telegram-bot-api server. Defaults resolve
# the compose service name, falling back to 127.0.0.1; override only if the
# container is published somewhere other than installer/docker-compose.yml
# puts it.
# TELEGRAM_BOT_API_HOST=
# TELEGRAM_BOT_API_PORT=

# Size cap for the raw-update debug log before it rotates (one generation
# is kept). It holds full message content, so it is both a disk-growth and
# a personal-data concern.
# RAW_UPDATES_MAX_BYTES=

# Message batching: a burst of messages inside the quiet period is
# delivered as one turn. Defaults live in telegram_listener/listener.py.
# MESSAGE_BATCH_QUIET_SECONDS=
# MESSAGE_BATCH_MAX_WAIT_SECONDS=
# MESSAGE_BATCH_MAX_MESSAGES=

# Optional speech-to-text. With an endpoint set, a voice message, audio
# file, video or video note arrives as what was said in it instead of as a
# file path, and the transcript is sent back into the chat. The expected
# shape is the OpenAI audio API, which whisper.cpp's server,
# faster-whisper-server and the OpenAI API itself all speak. Unset means
# the feature is simply off. Model/timeout/size-cap defaults live in
# telegram_listener/listener.py. The CONNECT_TIMEOUT knobs below are the
# connect half of each call's timeout, kept short on purpose: the read
# half has to be generous enough to transcribe a long recording, so
# without it an endpoint that resolves but is not up leaves the person who
# sent the voice note waiting out that whole read timeout in silence.
# TELEGRAM_STT_ENDPOINT=http://localhost:8000/v1/audio/transcriptions
# TELEGRAM_STT_MODEL=
# TELEGRAM_STT_TIMEOUT=
# TELEGRAM_STT_CONNECT_TIMEOUT=
# TRANSCRIBE_MAX_BYTES=

# Optional text-to-speech, same shape (/v1/audio/speech). With an endpoint
# set, the listener registers a /voice command that speaks text straight
# back, and a plugin can send a spoken reply via ListenerAPI.send_voice.
# TELEGRAM_TTS_ENDPOINT=http://localhost:8000/v1/audio/speech
# TELEGRAM_TTS_MODEL=
# TELEGRAM_TTS_VOICE=
# TELEGRAM_TTS_TIMEOUT=
# TELEGRAM_TTS_CONNECT_TIMEOUT=

# How long a new turn waits behind a turn already running for the same
# chat before the listener asks the plugin to interrupt it (only does
# anything for a plugin implementing interrupt_turn), and the default
# duration of a bare /sleep. Defaults in telegram_listener/listener.py.
# TURN_YIELD_GRACE_SECONDS=
# SLEEP_DEFAULT_SECONDS=

# How often, at most, the listener asks a plugin's live_context hook for
# fresh out-of-band state to fold into a turn.
# LIVE_CONTEXT_REFRESH_INTERVAL_SECONDS=

# Only needed by the claude_agent example plugin. Compaction thresholds,
# idle timeouts and the session-rotation timezone; defaults live in
# plugins/claude_agent.py.
# CLAUDE_AGENT_SYSTEM_PROMPT=
# CLAUDE_AGENT_TZ=Europe/Amsterdam
# CLAUDE_AGENT_COMPACT_CONTEXT_TOKENS=
# CLAUDE_AGENT_COMPACT_WAIT_TIMEOUT_SECONDS=
# CLAUDE_AGENT_IDLE_COMPACT_SECONDS=
# CLAUDE_AGENT_IDLE_CHECK_INTERVAL_SECONDS=
# CLAUDE_AGENT_SESSION_ROTATE_MIN_IDLE_SECONDS=
