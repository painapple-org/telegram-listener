# Telegram bot token (from @BotFather).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user ids allowed to talk to this bot.
# Everyone else is dropped and logged. Required: the listener refuses to
# start on an empty allowlist rather than run allowlisting nobody.
TELEGRAM_ALLOWED_USER_IDS=

# Optional second gate: comma-separated numeric chat ids an allowlisted
# user may talk to this bot from. Empty means any chat, including a group a
# stranger added the bot to. Set it to pin the bot to known chats.
# TELEGRAM_ALLOWED_CHAT_IDS=

# module.path:factory for the dispatch plugin to load - see
# telegram_listener/plugin.py. The example plugin shipped in this repo:
DISPATCH_PLUGIN=plugins.claude_agent:build_plugin

# Only needed by the claude_agent example plugin.
# CLAUDE_AGENT_MODEL=

# telegram-bot-api (installer/docker-compose.yml) - obtain from
# https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Where the listener stores its state (offset, transcripts, sessions,
# downloaded files). When unset, /data if it exists, else ./data.
# TELEGRAM_LISTENER_DATA_DIR=

# Where the listener reaches the telegram-bot-api server. Defaults resolve
# the compose service name, falling back to 127.0.0.1; override only if the
# container is published somewhere other than installer/docker-compose.yml
# puts it.
# TELEGRAM_BOT_API_HOST=
# TELEGRAM_BOT_API_PORT=

# Size cap for the raw-update debug log before it rotates (one generation
# is kept). It holds full message content, so it is both a disk-growth and
# a personal-data concern.
# RAW_UPDATES_MAX_BYTES=

# Message batching: a burst of messages inside the quiet period is
# delivered as one turn. Defaults live in telegram_listener/listener.py.
# MESSAGE_BATCH_QUIET_SECONDS=
# MESSAGE_BATCH_MAX_WAIT_SECONDS=
# MESSAGE_BATCH_MAX_MESSAGES=
